rules_version = '2';

// Rules for the "fixit" named Firestore database only (see firebase.json).
// This app DOES use Firebase Auth (Google Sign-In) — unlike
// rytc-behavior-score, request.auth is available here so access can
// genuinely be restricted to logged-in accounts. Any Google account can
// log in (no email-domain restriction — deliberate product decision, see
// AuthContext.jsx); the app's own "complete profile" step is what grants
// someone a usable staff profile, but the Firestore rule itself only
// checks that the request is authenticated at all.
//
// `stats/summary` and `publicRepairs/{repairId}` are the deliberate
// exceptions: they hold only non-personal fields (no name, national ID,
// phone, or person photo — see repairs.js for exactly what's copied into
// publicRepairs) so the public Dashboard can drill down into real matching
// records without login, per product decision. The full `repairs` doc
// (everything else here) requires an authenticated account.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null;
    }

    match /repairs/{repairId} {
      allow read, write: if isStaff();

      match /statusLogs/{logId} {
        allow read, write: if isStaff();
      }
    }

    match /staff/{uid} {
      allow read: if isStaff();
      allow write: if isStaff() && request.auth.uid == uid;
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /publicRepairs/{repairId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // โปรไฟล์ช่างซ่อม (ผู้ลงมือซ่อมจริง เช่น นักเรียน/นักศึกษา) — คนละเรื่องกับ staff/{uid}
    // (เจ้าหน้าที่ที่ล็อกอินเข้าระบบ) จัดการผ่านหน้า /technicians ในแอป ไม่ผูกกับบัญชี Auth ใดๆ
    match /technicians/{id} {
      allow read, write: if isStaff();
    }

    // dept/position เป็นข้อมูลอ้างอิงคงที่ (สาขาวิชา/ตำแหน่ง) ที่แอดมินเพิ่ม/แก้ผ่าน Firebase
    // Console เท่านั้น — แอปนี้อ่านอย่างเดียวตอนกรอกโปรไฟล์เจ้าหน้าที่ครั้งแรก จึงไม่เปิด write
    match /dept/{deptId} {
      allow read: if isStaff();
    }

    match /position/{positionId} {
      allow read: if isStaff();
    }
  }
}
