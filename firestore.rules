rules_version = '2';

// Rules for the "fixit" named Firestore database only (see firebase.json).
// This app DOES use Firebase Auth (Google Sign-In, restricted to
// @technicrayong.ac.th accounts) — unlike rytc-behavior-score, request.auth
// is available here so access can genuinely be restricted to logged-in
// staff. The domain check here is the real enforcement: the app's
// AuthContext also checks the domain and signs out non-matching accounts,
// but that's client-side and can be bypassed, so isStaff() re-checks the
// email domain from the ID token on every request.
//
// `stats/summary` and `publicRepairs/{repairId}` are the deliberate
// exceptions: they hold only non-personal fields (no name, national ID,
// phone, or person photo — see repairs.js for exactly what's copied into
// publicRepairs) so the public Dashboard can drill down into real matching
// records without login, per product decision. The full `repairs` doc
// (everything else here) requires an authenticated @technicrayong.ac.th
// account.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email.matches('.*@technicrayong[.]ac[.]th$');
    }

    match /repairs/{repairId} {
      allow read, write: if isStaff();

      match /statusLogs/{logId} {
        allow read, write: if isStaff();
      }
    }

    match /staff/{uid} {
      allow read: if isStaff();
      allow write: if isStaff() && request.auth.uid == uid;
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /publicRepairs/{repairId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // dept/position เป็นข้อมูลอ้างอิงคงที่ (สาขาวิชา/ตำแหน่ง) ที่แอดมินเพิ่ม/แก้ผ่าน Firebase
    // Console เท่านั้น — แอปนี้อ่านอย่างเดียวตอนกรอกโปรไฟล์เจ้าหน้าที่ครั้งแรก จึงไม่เปิด write
    match /dept/{deptId} {
      allow read: if isStaff();
    }

    match /position/{positionId} {
      allow read: if isStaff();
    }
  }
}
