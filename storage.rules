rules_version = '2';

// Photos under fixit/{repairId}/... include images of requesters and staff,
// so read/write is restricted to authenticated staff accounts only — never public.
service firebase.storage {
  match /b/{bucket}/o {
    match /fixit/{repairId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
