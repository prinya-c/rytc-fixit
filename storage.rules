rules_version = '2';

// ⚠️ Storage rules are GLOBAL to the whole `rytc-app` bucket — unlike
// Firestore, they are NOT scoped per named database. This file must contain
// the rules for EVERY app that uses this bucket, not just RYTC-Fix, or a
// deploy from this repo will silently wipe out other apps' access rules.
//
// The `home-visits/`, `homeroom-logs/`, and `dropout-follow-ups/` blocks
// below are copied verbatim from prinya-c/rytc-care-plus's own storage.rules
// (that repo owns those paths) so this file stays a faithful superset of
// what is actually live, restored after an accidental deploy from this repo
// overwrote them on 2026-08-30.
//
// `join-rytc/` is owned by prinya-c/rytc-join, which never committed a
// storage.rules file (rules were set directly in Console, not tracked in
// git) — so the block below is a RECONSTRUCTION, not a verified original.
// It's inferred from src/services/firebaseStorageService.js in that repo:
// uploads happen from an unauthenticated public form (no Firebase Auth in
// that app at all) restricted client-side to images ≤ 5MB. The rule below
// enforces the same limits server-side rather than leaving write wide open.
// ⚠️ Confirm the join-rytc upload form still works after deploying this,
// since this couldn't be verified against the original text.
//
// The `users/{uid}/avatar.jpg` block below is copied verbatim from
// prinya-c/rytc-pay's own storage.rules (that repo owns this path).
service firebase.storage {
  match /b/{bucket}/o {
    // --- prinya-c/rytc-care-plus ---

    // Home visit photos and map images.
    match /home-visits/{studentId}/{fileName} {
      allow read: if true;
      // request.resource is null on delete, so a delete must be its own
      // branch — folding it into `write` alongside the size/type check
      // would evaluate that check against a null resource and always deny.
      allow create, update: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // Homeroom activity log photos.
    match /homeroom-logs/{classId}/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // Dropout follow-up evidence photos.
    match /dropout-follow-ups/{studentId}/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // --- prinya-c/rytc-join (reconstructed, see comment above) ---

    match /join-rytc/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // --- prinya-c/rytc-pay ---

    // Profile avatars — owner read/write, others read
    match /users/{uid}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // --- prinya-c/rytc-fixit (this app) ---

    // Photos under fixit/{repairId}/... include images of requesters and
    // staff, so read/write is restricted to authenticated staff accounts.
    match /fixit/{repairId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Anything not explicitly matched above is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
